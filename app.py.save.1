@app.route('/api/usuarios/<string:username>', methods=['PUT'])
def actualizar_usuario(username):
    data = request.get_json()
    update_data = {}
    if 'nombre' in data:
        update_data['nombre'] = data['nombre']
    if 'rol' in data:
        update_data['rol'] = data['rol']
    if 'password' in data and data['password']:
        update_data['password'] = data['password']
    if 'activo' in data:
        update_data['activo'] = data['activo']
    
    if not update_data:
        return jsonify({"error": "No hay datos para actualizar"}), 400
    
    result = supabase.table('usuarios').update(update_data).eq('username', username).execute()
    if not result.data:
        return jsonify({"error": "Usuario no encontrado"}), 404
    return jsonify({"mensaje": "Usuario actualizado"})

@app.route('/api/usuarios/<string:username>', methods=['DELETE'])
def eliminar_usuario(username):
    if username == 'admin':
        return jsonify({"error": "No se puede eliminar al administrador principal"}), 400
    result = supabase.table('usuarios').delete().eq('username', username).execute()
    if not result.data:
        return jsonify({"error": "Usuario no encontrado"}), 404
    return jsonify({"mensaje": "Usuario eliminado"})

