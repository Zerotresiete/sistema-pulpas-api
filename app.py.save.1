@app.route('/compras/<int:id>/recibir', methods=['PUT'])
def recibir_compra(id):
    """Marcar compra como recibida (actualiza stock automáticamente)"""
    try:
        # Verificar que la compra existe
        compra = supabase.table('compras').select("*").eq('id', id).execute()
        if not compra.data:
            return jsonify({"error": "Compra no encontrada"}), 404
        
        if compra.data[0]['estado'] == 'recibida':
            return jsonify({"error": "Compra ya fue recibida"}), 400
        
        # Cambiar estado a recibida (el trigger actualiza el stock)
        supabase.table('compras').update({
            'estado': 'recibida',
            'fecha_entrega': datetime.now().strftime("%Y-%m-%d")
        }).eq('id', id).execute()
        
        return jsonify({
            "mensaje": "Compra recibida y stock actualizado"
        })
        
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route('/compras/<int:id>/pagar', methods=['PUT'])
def pagar_compra(id):
    """Registrar pago de una compra"""
    try:
        data = request.get_json()
        
        compra = supabase.table('compras').select("*").eq('id', id).execute()
        if not compra.data:
            return jsonify({"error": "Compra no encontrada"}), 404
        
        # Registrar el pago
        pago = {
            "compra_id": id,
            "fecha_pago": data.get('fecha_pago', datetime.now().strftime("%Y-%m-%d")),
            "monto": data.get('monto', compra.data[0]['total']),
            "metodo_pago": data.get('metodo_pago'),
            "referencia": data.get('referencia'),
            "observaciones": data.get('observaciones')
        }
        supabase.table('pagos_proveedores').insert(pago).execute()
        
        # Cambiar estado de la compra a pagada
        supabase.table('compras').update({
            'estado': 'pagada',
            'fecha_pago': datetime.now().strftime("%Y-%m-%d")
        }).eq('id', id).execute()
        
        return jsonify({"mensaje": "Pago registrado exitosamente"})
        
    except Exception as e:
        return jsonify({"error": str(e)}), 500

